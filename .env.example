# Postgres connection string (docker-compose.yml exposes the DB on port 5434)
DATABASE_URL=postgres://choosehealth:choosehealth@localhost:5434/choosehealth

# Owner account (default super admin; can't be deleted). Sign in at /admin/login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional display name for the owner in the admin area
# ADMIN_NAME=William Owusu

# Optional but recommended in production: a long random string used to sign admin sessions.
# Without it, sessions are signed with ADMIN_PASSWORD, so changing that password signs everyone out.
# Generate one with: openssl rand -base64 32
# AUTH_SECRET=
